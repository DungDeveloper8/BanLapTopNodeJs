<section class="admin-page">
  <div class="admin-title">
    <div>
      <h1>Quản lý đơn hàng</h1>
      <p>Kiểm tra đơn, chuyển giao hàng và xác nhận đã giao.</p>
    </div>
  </div>

  <div class="table-card table-scroll">
    <table class="orders-table">
      <thead>
        <tr>
          <th>Mã đơn</th>
          <th>Người nhận</th>
          <th>Ngày đặt</th>
          <th>Tổng tiền</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        {{#each orders}}
          <tr>
            <td><strong>#{{id}}</strong></td>
            <td>{{customer_name}}</td>
            <td>{{formatDate created_at}}</td>
            <td><strong>{{formatCurrency total_price}}</strong></td>
            <td>
              <span class="status-pill {{orderStatusClass order_status}}">
                {{orderStatus order_status}}
              </span>
            </td>
            <td>
              <a class="btn btn-outline btn-small" href="/admin/orders/{{id}}">Xử lý</a>
            </td>
          </tr>
        {{else}}
          <tr><td class="table-empty" colspan="6">Chưa có đơn hàng.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
