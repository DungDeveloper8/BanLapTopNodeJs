<section class="admin-page">
  <div class="admin-title">
    <div><h1>Sửa sản phẩm</h1><p>Cập nhật sản phẩm #{{product.id}}.</p></div>
    <a class="btn btn-outline" href="/admin/products">Quay lại</a>
  </div>

  <div class="form-card admin-form-card">
    {{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}
    <form class="form-stack" action="/admin/products/{{product.id}}/edit" method="POST">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="form-grid">
        <label>Tên sản phẩm
          <input type="text" name="name" value="{{product.name}}" maxlength="255" required>
        </label>
        <label>Hãng
          <input type="text" name="brand" value="{{product.brand}}" maxlength="100" required>
        </label>
        <label>Loại sản phẩm
          <select name="category" required>
            <option value="Phụ kiện" {{#if product.isAccessory}}selected{{/if}}>Phụ kiện</option>
            <option value="Điện thoại" {{#if product.isPhone}}selected{{/if}}>Điện thoại</option>
          </select>
        </label>
        <label>Giá (VNĐ)
          <input type="number" name="price" value="{{product.price}}" min="0" step="1" required>
        </label>
        <label>Tồn kho
          <input type="number" name="stock" value="{{product.stock}}" min="0" step="1" required>
        </label>
        <label>RAM (GB; để trống nếu là phụ kiện)
          <input type="number" name="ram_gb" value="{{product.ram_gb}}" min="1" step="1">
        </label>
        <label>Bộ nhớ (GB; để trống nếu là phụ kiện)
          <input type="number" name="storage_gb" value="{{product.storage_gb}}" min="1" step="1">
        </label>
      </div>
      <label>Đường dẫn ảnh
        <input type="text" name="image" value="{{product.image}}" maxlength="2048">
      </label>
      <label>Mô tả
        <textarea name="description" rows="6">{{product.description}}</textarea>
      </label>
      <button class="btn btn-primary" type="submit">Cập nhật sản phẩm</button>
    </form>
  </div>
</section>
