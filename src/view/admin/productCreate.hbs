<section class="admin-page">
  <div class="admin-title">
    <div>
      <h1>Thêm sản phẩm</h1>
      <p>Nhập thông tin laptop mới.</p>
    </div>
    <a class="btn btn-outline" href="/admin/products">Quay lại</a>
  </div>

  <div class="form-card admin-form-card">
    {{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}

    <form class="form-stack" action="/admin/products/create" method="POST">
      <div class="form-grid">
        <label>
          Tên laptop
          <input type="text" name="name" value="{{form.name}}" maxlength="255" required>
        </label>

        <label>
          Hãng
          <input type="text" name="brand" value="{{form.brand}}" maxlength="100" required>
        </label>

        <label>
          Giá
          <input type="number" name="price" value="{{form.price}}" min="0" step="1000" required>
        </label>
      </div>

      <label>
        Đường dẫn ảnh
        <input type="text" name="image" value="{{form.image}}" maxlength="255" placeholder="/images/products/ten-anh.png">
      </label>

      <label>
        Mô tả
        <textarea name="description" rows="6">{{form.description}}</textarea>
      </label>

      <button class="btn btn-primary" type="submit">Lưu sản phẩm</button>
    </form>
  </div>
</section>
